{
  "kind": "collectionType",
  "collectionName": "patients",
  "info": {
    "singularName": "patient",
    "pluralName": "patients",
    "displayName": "Patient"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nik": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string"
    },
    "birthDate": {
      "type": "date"
    },
    "gender": {
      "type": "enumeration",
      "enum": [
        "L",
        "P"
      ]
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "bloodType": {
      "type": "string"
    },
    "allergies": {
      "type": "json"
    },
    "registeredAt": {
      "type": "date"
    },
    "faskes": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::faskes.faskes",
      "inversedBy": "patients"
    }
  }
}
