{
  "kind": "collectionType",
  "collectionName": "patients",
  "info": {
    "singularName": "patient",
    "pluralName": "patients",
    "displayName": "Patient"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nik": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string"
    },
    "birthDate": {
      "type": "date"
    },
    "gender": {
      "type": "enumeration",
      "enum": [
        "L",
        "P"
      ]
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "bloodType": {
      "type": "string"
    },
    "allergies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::patient-allergy.patient-allergy",
      "mappedBy": "patient"
    },
    "registrations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::registration.registration",
      "mappedBy": "patient"
    },
    "emr_documents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::emr-document.emr-document",
      "mappedBy": "patient"
    },
    "registeredAt": {
      "type": "date"
    },
    "faskes": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::faskes.faskes",
      "inversedBy": "patients"
    },
    "invoices": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::invoice.invoice",
      "mappedBy": "patient"
    },
    "bookings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::booking.booking",
      "mappedBy": "patient"
    },
    "letters": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::letter.letter",
      "mappedBy": "patient"
    },
    "referrals": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::referral.referral",
      "mappedBy": "patient"
    },
    "apotek_invoices": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::apotek-invoice.apotek-invoice",
      "mappedBy": "patient"
    },
    "insurance_claims": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::insurance-claim.insurance-claim",
      "mappedBy": "patient"
    }
  }
}
