      "enum": ["Tablet", "Kapsul", "Botol", "Ampul", "Pcs", "Strip", "Buah"]
    },
    "minStock": {
      "type": "integer",
      "default": 0
    },
    "price": {
      "type": "integer",
      "default": 0
    },
    "supplier": {
      "type": "string"
    }
